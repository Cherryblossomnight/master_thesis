% pdf内のハイパーリンクの設定
% コンパイル時間が倍増するため, 基本はコメントアウト推奨
\AtEndOfPackage{
  \usepackage[dvipdfmx,
    bookmarks=true,% ブックマークを作成
    bookmarksnumbered=true,% しおりのレベル
    colorlinks=false,% false: boxed links; true: colored links
    setpagesize=false,
    hyperfootnotes=false,
	pdfborder={0 0 0},
    pdfsubject={修士論文},   % text for PDF Subject field
    ]{hyperref}%
  \usepackage{pxjahyper}%
}

% 目次の深さ
\setcounter{tocdepth}{2}

\renewcommand{\figurename}{Fig.}
\renewcommand{\tablename}{Table}

% 参照を楽にするコマンド
\def \figref #1{\figurename\ref{#1}}
\def \tbref #1{\tablename\ref{#1}}
\def \equref #1{式(\ref{#1})}
\def \chapref #1{Chapter\ref{#1}}
\def \appendixref #1{付録\ref{#1}}
\def \secref  #1{\ref{#1}節}
\def \subsecref  #1{\ref{#1}小節}

\def\thesis #1{\gdef\@thesis{#1}}
\def\teacher #1{\gdef\@teacher{#1}}
\def\organization #1{\gdef\@organization{#1}}

\renewcommand{\maketitle}{
    \thispagestyle{empty}
    \begin{center}
        \vspace*{2cm}
        \LARGE \@thesis 
        \hspace*{\fill}\leavevmode\\
        \vspace{2cm}
        \LARGE{\bf \@title}
        \hspace*{\fill}\leavevmode\\
        \label{font_title}
        \Large
        \vspace{5cm}
        \@date \hspace*{0.5zw}提出 
        \hspace*{\fill}\leavevmode\\
        \vspace{1cm}
        指導教員 \@teacher 
        \hspace*{\fill}\leavevmode\\
        \Large
        \vspace{1cm}
        \@organization
        \hspace*{\fill}\leavevmode\\
        \LARGE
        \@author 
        \hspace*{\fill}\leavevmode\\
        \normalsize
    \end{center}
    \clearpage
    \mbox{}
    \thispagestyle{empty}
    \clearpage
}

\usepackage{fancyhdr}

\pagestyle{fancy}
\fancyhf{}

\fancyhead[L]{\bfseries --- \leftmark\ ---}
\fancyhead[R]{\bfseries \thepage}

\renewcommand{\headrulewidth}{0.4pt}

\renewcommand{\chaptermark}[1]{%
  \markboth{Chapter \thechapter: #1}{}
}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead[L]{\bfseries --- \leftmark\ ---}
  \fancyhead[R]{\bfseries \thepage}
  \renewcommand{\headrulewidth}{0.4pt}
}


\renewcommand{\contentsname}{}

\renewcommand{\prechaptername}{Chapter~}
\renewcommand{\postchaptername}{}

\makeatletter

\renewcommand{\chapter}{%
  \if@openright\cleardoublepage\else\clearpage\fi
  \thispagestyle{empty}%
  \global\@topnum\z@
  \@afterindentfalse
  \secdef\@chapter\@schapter
}

\def\@makechapterhead#1{%
  \vspace*{\fill}
  \begin{center}
    {\Huge\bfseries Chapter~\thechapter\par}
    \vspace{1cm}
    {\Huge\bfseries #1\par}
  \end{center}
  \vspace*{\fill}
  \clearpage
  \thispagestyle{empty}
  \mbox{}
  \clearpage
}

\def\@makeschapterhead#1{}
\renewcommand{\bibname}{References}
\makeatother